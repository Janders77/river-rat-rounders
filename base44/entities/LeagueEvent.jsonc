{
  "name": "LeagueEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the event"
    },
    "event_time": {
      "type": "string",
      "description": "Time of the event (e.g. 7:00 PM)"
    },
    "location": {
      "type": "string",
      "description": "Where the event takes place"
    },
    "address": {
      "type": "string",
      "description": "Street address of the event"
    },
    "description": {
      "type": "string",
      "description": "Details about the event"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "Regular Game",
        "Tournament",
        "Special Event",
        "Meeting",
        "Other"
      ],
      "default": "Regular Game",
      "description": "Type of event"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Images for the event"
    }
  },
  "required": [
    "title",
    "event_date"
  ]
}